# cronops-server image: REST API + built web UI
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ api/
COPY cmd/server/ cmd/server/
COPY internal/apiserver/ internal/apiserver/
COPY internal/auth/ internal/auth/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cronops-server ./cmd/server

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/cronops-server /cronops-server
COPY --from=web /web/dist /web/dist
USER 65532:65532
ENTRYPOINT ["/cronops-server", "--static", "/web/dist"]
